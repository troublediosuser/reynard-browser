+- (void)cancelExtensionRequestWithIdentifier:(NSUUID*)requestIdentifier;
+- (void)setRequestInterruptionBlock:
+    (void (^_Nonnull)(NSUUID* requestIdentifier))block;
+- (void)setRequestCancellationBlock:
