+static dispatch_queue_t ExtensionLaunchQueue() {
+  static dispatch_queue_t queue;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    queue = dispatch_queue_create("com.minh-ton.Reynard.ExtensionLaunchQueue",
+                                  DISPATCH_QUEUE_SERIAL);
+  });
+  return queue;
+}
+
+static dispatch_queue_t ExtensionCompletionQueue() {
+  static dispatch_queue_t queue;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    queue = dispatch_queue_create(
+        "com.minh-ton.Reynard.ExtensionCompletionQueue", DISPATCH_QUEUE_SERIAL);
+  });
+  return queue;
+}
+
+static NSError* ExtensionLaunchError(NSString* description,
+                                     NSError* _Nullable underlying = nil) {
+  NSDictionary* userInfo = underlying
+                               ? @{
+                                   NSLocalizedDescriptionKey : description,
+                                   NSUnderlyingErrorKey : underlying,
+                                 }
+                               : @{NSLocalizedDescriptionKey : description};
+  return [NSError errorWithDomain:@"ReynardExtension" code:1 userInfo:userInfo];
+}
+
+// LiveContainer support.
+//
+// Inside LiveContainer, iOS does not know about a guest app's extensions, so
+// "Reynard Helper.appex" cannot be launched. Child processes are hosted by
+// LiveContainer's own LiveProcess extension instead: LiveProcess loads
+// ReynardLiveContainerLoader.dylib (its "customPayloadDylib" feature), and the
+// loader boots the Gecko child the same way Reynard Helper does.
+//
+// LCSharedUtils only exists in a LiveContainer guest process, so none of the
+// code paths below run on normal installs.
+
+static bool ReynardUnderLiveContainer() {
+  return NSClassFromString(@"LCSharedUtils") != Nil;
+}
+
+// +[NSUserDefaults isLiveProcess] and +isSharedApp return C bool.
+static bool ReynardLiveContainerFlag(NSString* aSelectorName) {
+  SEL selector = NSSelectorFromString(aSelectorName);
+  Class defaults = [NSUserDefaults class];
+  if (![defaults respondsToSelector:selector]) {
+    return false;
+  }
+  return ((bool (*)(id, SEL))objc_msgSend)(defaults, selector);
+}
+
+// +[NSUserDefaults lcMainBundle] is LiveContainer.app, or LiveProcess.appex
+// when Reynard itself runs in LiveContainer's multitask mode.
+static NSBundle* _Nullable ReynardLiveContainerMainBundle() {
+  SEL selector = NSSelectorFromString(@"lcMainBundle");
+  Class defaults = [NSUserDefaults class];
+  if (![defaults respondsToSelector:selector]) {
+    return nil;
+  }
+  id bundle = ((id (*)(id, SEL))objc_msgSend)(defaults, selector);
+  return [bundle isKindOfClass:[NSBundle class]] ? bundle : nil;
+}
+
+static bool ReynardLiveContainerRespondsTo(NSString* aSelectorName) {
+  return [NSClassFromString(@"LCSharedUtils")
+      respondsToSelector:NSSelectorFromString(aSelectorName)];
+}
+
+// Calls a +[LCSharedUtils ...] method that returns an object.
+static id _Nullable ReynardLiveContainerValue(NSString* aSelectorName) {
+  if (!ReynardLiveContainerRespondsTo(aSelectorName)) {
+    return nil;
+  }
+  return ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"LCSharedUtils"),
+                                         NSSelectorFromString(aSelectorName));
+}
+
+static NSString* _Nullable GetLiveContainerExtensionIdentifier() {
+  NSBundle* lcBundle = ReynardLiveContainerMainBundle();
+  if (!lcBundle) {
+    return nil;
+  }
+
+  if (ReynardLiveContainerFlag(@"isLiveProcess")) {
+    return [lcBundle bundleIdentifier];
+  }
+
+  NSURL* plugInsURL = [lcBundle builtInPlugInsURL];
+  if (plugInsURL) {
+    NSURL* extensionURL =
+        [plugInsURL URLByAppendingPathComponent:@"LiveProcess.appex"];
+    NSString* identifier =
+        [[NSBundle bundleWithURL:extensionURL] bundleIdentifier];
+    if (identifier) {
+      return identifier;
+    }
+  }
+
+  // Additional LiveContainer installs (LiveContainer2 and later) ship without
+  // app extensions and use the first LiveContainer's LiveProcess, the same
+  // way +[LCUtils liveProcessBundleIdentifier] finds it.
+  id teamIdentifier = ReynardLiveContainerValue(@"teamIdentifier");
+  if (![teamIdentifier isKindOfClass:[NSString class]]) {
+    return nil;
+  }
+  NSString* identifier = [NSString
+      stringWithFormat:@"com.kdt.livecontainer.%@.LiveProcess", teamIdentifier];
+  return [NSExtension extensionWithIdentifier:identifier error:nil] ? identifier
+                                                                    : nil;
+}
+
+// Builds the LiveProcess request. LiveProcess loads customPayloadDylib before
+// it resolves any bookmarks, so the loader and GeckoView must be readable
+// without one. That is only true for LiveContainer "shared apps", whose bundle
+// lives in the App Group container.
+static NSDictionary* _Nullable ReynardLiveContainerUserInfo(
+    NSXPCListenerEndpoint* aEndpoint, NSError* _Nullable* _Nonnull aError) {
+  if (!ReynardLiveContainerFlag(@"isSharedApp")) {
+    *aError = ExtensionLaunchError(
+        @"Reynard must be a LiveContainer shared app to run inside "
+        @"LiveContainer. In LiveContainer, long-press Reynard and choose "
+        @"\"Convert to Shared App\".");
+    return nil;
+  }
+
+  // Without a certificate, LiveContainer runs guest apps with JIT and does not
+  // re-sign them, and LiveProcess cannot load unsigned code as a payload.
+  if (ReynardLiveContainerRespondsTo(@"certificatePassword") &&
+      !ReynardLiveContainerValue(@"certificatePassword")) {
+    *aError = ExtensionLaunchError(
+        @"Reynard needs LiveContainer's JIT-less mode to run inside "
+        @"LiveContainer. In LiveContainer settings, tap \"Import Certificate "
+        @"from SideStore\" or \"Import Certificate\", then open Reynard "
+        @"again.");
+    return nil;
+  }
+
+  NSString* frameworksPath = [[NSBundle mainBundle] privateFrameworksPath];
+  if (!frameworksPath) {
+    *aError = ExtensionLaunchError(
+        @"Unable to resolve the Frameworks directory of Reynard.app");
+    return nil;
+  }
+
+  NSString* loaderPath = [frameworksPath
+      stringByAppendingPathComponent:@"ReynardLiveContainerLoader.dylib"];
+  NSString* geckoViewPath = [frameworksPath
+      stringByAppendingPathComponent:@"GeckoView.framework/GeckoView"];
+  NSString* greDir = [frameworksPath
+      stringByAppendingPathComponent:@"GeckoView.framework/Frameworks"];
+
+  NSFileManager* fileManager = [NSFileManager defaultManager];
+  for (NSString* path in @[ loaderPath, geckoViewPath, greDir ]) {
+    if (![fileManager fileExistsAtPath:path]) {
+      *aError = ExtensionLaunchError(
+          [NSString stringWithFormat:@"Missing %@", path]);
+      return nil;
+    }
+  }
+
+  return @{
+    @"ReynardXPCListenerEndpoint" : aEndpoint,
+    @"customPayloadDylib" : loaderPath,
+    @"customPayloadEntry" : @"ReynardLiveContainerPayloadMain",
+    @"reynardGeckoViewPath" : geckoViewPath,
+    @"reynardGREDir" : greDir,
+  };
+}
+
+static NSString* _Nullable GetExtensionIdentifier() {
+  if (ReynardUnderLiveContainer()) {
+    return GetLiveContainerExtensionIdentifier();
+  }
+
+  NSURL* plugInsURL = [[NSBundle mainBundle] builtInPlugInsURL];
+  if (!plugInsURL) {
+    return nil;
+  }
+
+  NSURL* extensionURL =
+      [plugInsURL URLByAppendingPathComponent:@"Reynard Helper.appex"];
+  return [[NSBundle bundleWithURL:extensionURL] bundleIdentifier];
+}
+
+@interface ExtensionProcess : NSObject {
+ @private
+  NSExtension* mExtension;
+  NSXPCListener* mListener;
+  ExtensionConnectionDelegate* mListenerDelegate;
+  NSXPCConnection* mConnection;
+  NSUUID* mRequestIdentifier;
+  xpc_connection_t mLibXPCConnection;
+  bool mInvalidated;
+}
+
+- (void)startWithCompletion:
+    (void (^_Nonnull)(NSError* _Nullable error))aCompletion;
+- (xpc_connection_t _Nullable)copyLibXPCConnection;
+- (void)invalidate;
+
+@end
+
+@implementation ExtensionProcess
+
+- (void)startWithCompletion:
+    (void (^_Nonnull)(NSError* _Nullable error))aCompletion {
+  void (^completion)(NSError* _Nullable) = [aCompletion copy];
+
+  dispatch_async(ExtensionLaunchQueue(), ^{
+    const bool underLiveContainer = ReynardUnderLiveContainer();
+    __block bool completed = false;
+    void (^completeOnce)(NSError* _Nullable) = ^(NSError* _Nullable error) {
+      dispatch_async(ExtensionCompletionQueue(), ^{
+        if (completed) {
+          return;
+        }
+        completed = true;
+        completion(error);
+        [completion release];
+      });
+    };
+
+    if (mInvalidated) {
+      completeOnce(
+          ExtensionLaunchError(@"NSExtension process already invalidated"));
+      return;
+    }
+
+    mListenerDelegate = [[ExtensionConnectionDelegate alloc] init];
+    mListener = [[NSXPCListener anonymousListener] retain];
+
+    __block ExtensionProcess* process = self;
+    [mListenerDelegate setConnectionHandler:^(NSXPCConnection* connection) {
+      if (process->mInvalidated || process->mConnection) {
+        [connection invalidate];
+        return;
+      }
+
+      process->mConnection = [connection retain];
+      [process->mListenerDelegate setPingHandler:^{
+        completeOnce(nil);
+      }];
+      [process->mConnection
+          setExportedInterface:
+              [NSXPCInterface
+                  interfaceWithProtocol:@protocol(ExtensionBootstrapPing)]];
+      [process->mConnection setExportedObject:process->mListenerDelegate];
+      [process->mConnection setInvalidationHandler:^{
+        completeOnce(ExtensionLaunchError(
+            @"NSXPC connection invalidated before bootstrap"));
+      }];
+
+      xpc_connection_t libXPC = [process->mConnection _xpcConnection];
+      if (libXPC) {
+        process->mLibXPCConnection = xpc_retain(libXPC);
+      }
+
+      if (!process->mLibXPCConnection) {
+        completeOnce(ExtensionLaunchError(
+            @"Failed to get libxpc connection from NSXPCConnection"));
+        return;
+      }
+    }];
+
+    [mListener setDelegate:mListenerDelegate];
+    [mListener resume];
+
+    NSString* extensionIdentifier = GetExtensionIdentifier();
+    if (!extensionIdentifier) {
+      completeOnce(ExtensionLaunchError(
+          underLiveContainer
+              ? @"LiveContainer's LiveProcess extension was not found. "
+                @"Reinstall LiveContainer and keep its app extensions."
+              : @"Unable to resolve extension bundle identifier"));
+      return;
+    }
+
+    NSError* extensionError = nil;
+    mExtension = [[NSExtension extensionWithIdentifier:extensionIdentifier
+                                                 error:&extensionError] retain];
+    if (!mExtension) {
+      completeOnce(ExtensionLaunchError(@"Failed to create NSExtension",
+                                        extensionError));
+      return;
+    }
+
+    [mExtension setRequestInterruptionBlock:^(NSUUID* requestIdentifier) {
+      completeOnce(ExtensionLaunchError(
+          underLiveContainer
+              ? @"LiveProcess exited before connecting back. It may have "
+                @"failed to load ReynardLiveContainerLoader.dylib, which "
+                @"needs Reynard to be signed by LiveContainer (JIT-less mode)."
+              : @"NSExtension request interrupted before bootstrap"));
+    }];
+
+    // The LiveContainer loader cancels the request with a descriptive error
+    // when it cannot boot the Gecko child.
+    if (underLiveContainer &&
+        [mExtension respondsToSelector:@selector(setRequestCancellationBlock:)]) {
+      [mExtension setRequestCancellationBlock:^(NSUUID* requestIdentifier,
+                                                NSError* _Nullable error) {
+        completeOnce(ExtensionLaunchError(
+            @"LiveProcess cancelled the child process request", error));
+      }];
+    }
+
+    NSExtensionItem* input = [[[NSExtensionItem alloc] init] autorelease];
+    if (underLiveContainer) {
+      NSError* userInfoError = nil;
+      NSDictionary* userInfo =
+          ReynardLiveContainerUserInfo([mListener endpoint], &userInfoError);
+      if (!userInfo) {
+        completeOnce(userInfoError);
+        return;
+      }
+      [input setUserInfo:userInfo];
+    } else {
+      [input setUserInfo:@{@"ReynardXPCListenerEndpoint" : [mListener endpoint]}];
+    }
+
+    NSError* requestError = nil;
+    mRequestIdentifier =
+        [[mExtension beginExtensionRequestWithInputItems:@[ input ]
+                                                   error:&requestError] retain];
+    if (!mRequestIdentifier) {
+      completeOnce(ExtensionLaunchError(@"Failed to start NSExtension request",
+                                        requestError));
+      return;
+    }
+
+    // LiveProcess also has to load the loader, GeckoView and XUL before it can
+    // connect back, so give it longer.
+    const uint64_t timeoutSeconds = underLiveContainer ? 20 : 8;
+    dispatch_after(
+        dispatch_time(DISPATCH_TIME_NOW, timeoutSeconds * NSEC_PER_SEC),
+        ExtensionLaunchQueue(), ^{
+          completeOnce(ExtensionLaunchError(
+              @"Timed out waiting for child extension NSXPC connection"));
+        });
+  });
+}
+
+- (xpc_connection_t _Nullable)copyLibXPCConnection {
+  return mLibXPCConnection ? xpc_retain(mLibXPCConnection) : nullptr;
+}
+
+- (void)invalidate {
+  mInvalidated = true;
+
+  if (mLibXPCConnection) {
+    xpc_connection_cancel(mLibXPCConnection);
+    xpc_release(mLibXPCConnection);
+    mLibXPCConnection = nullptr;
+  }
+
+  if (mConnection) {
+    [mConnection invalidate];
+    [mConnection release];
+    mConnection = nil;
+  }
+
+  if (mExtension) {
+    if (mRequestIdentifier) {
+      [mExtension cancelExtensionRequestWithIdentifier:mRequestIdentifier];
+    }
+    [mExtension release];
+    mExtension = nil;
+  }
+
+  if (mRequestIdentifier) {
+    [mRequestIdentifier release];
+    mRequestIdentifier = nil;
+  }
+
+  if (mListener) {
+    [mListener setDelegate:nil];
+    [mListener invalidate];
+    [mListener release];
+    mListener = nil;
+  }
+
+  if (mListenerDelegate) {
+    [mListenerDelegate setConnectionHandler:nil];
+    [mListenerDelegate setPingHandler:nil];
+    [mListenerDelegate release];
+    mListenerDelegate = nil;
+  }
+}
+
+- (void)dealloc {
+  [self invalidate];
+  [super dealloc];
+}
+
+@end
+
+NS_ASSUME_NONNULL_END
+
+namespace mozilla::ipc {
+
+void BEProcessCapabilityGrantDeleter::operator()(void* _Nullable aGrant) const {
+}
+
+void NSExtensionProcess::StartProcess(
+    const std::function<void(Result<NSExtensionProcess, LaunchError>&&)>&
+        aCompletion) {
+  auto ownedCompletion = std::make_shared<
+      std::function<void(Result<NSExtensionProcess, LaunchError>&&)>>(
+      aCompletion);
+
+  ExtensionProcess* process = [[ExtensionProcess alloc] init];
+
+  [process startWithCompletion:^(NSError* error) {
+    if (error) {
+      if (ReynardUnderLiveContainer()) {
+        NSLog(@"[Reynard] LiveContainer child process launch failed: %@",
+              error);
+      }
+      [process release];
+      (*ownedCompletion)(Err(LaunchError("NSExtensionProcess::StartProcess")));
+      return;
+    }
+
+    (*ownedCompletion)(NSExtensionProcess(process));
+  }];
+}
+
+DarwinObjectPtr<xpc_connection_t> NSExtensionProcess::MakeLibXPCConnection() {
+  return AdoptDarwinObject(
+      [static_cast<ExtensionProcess*>(mProcessObject) copyLibXPCConnection]);
+}
+
+void NSExtensionProcess::Invalidate() {
+  [static_cast<ExtensionProcess*>(mProcessObject) invalidate];
+}
+
+UniqueBEProcessCapabilityGrant NSExtensionProcess::GrantForegroundCapability() {
+  return UniqueBEProcessCapabilityGrant(nil);
+}
+
+NSExtensionProcess::NSExtensionProcess(const NSExtensionProcess& aOther)
+    : mProcessObject(aOther.mProcessObject) {
+  [static_cast<ExtensionProcess*>(mProcessObject) retain];
+}
+
+NSExtensionProcess& NSExtensionProcess::operator=(
+    const NSExtensionProcess& aOther) {
+  void* oldProcessObject = std::exchange(mProcessObject, aOther.mProcessObject);
+  [static_cast<ExtensionProcess*>(mProcessObject) retain];
+  [static_cast<ExtensionProcess*>(oldProcessObject) release];
+  return *this;
+}
+
+NSExtensionProcess::~NSExtensionProcess() {
+  [static_cast<ExtensionProcess*>(mProcessObject) release];
+}
+
+void LockdownNSExtensionProcess(NSExtensionSandboxRevision aRevision) {
+  if (id<GeckoProcessExtension> process = GetCurrentProcessExtension()) {
+    switch (aRevision) {
+      case NSExtensionSandboxRevision::Revision1:
+        [process lockdownSandbox:@"1.0"];
+        return;
+      default:
+        NSLog(@"Unknown NSExtension sandbox revision");
+        return;
+    }
+  }
+}
+
+}  // namespace mozilla::ipc
